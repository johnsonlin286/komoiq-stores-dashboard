# Salin ke .env.local. Jangan masukkan rahasia sungguhan ke repositori.
# Sesi aplikasi tetap ditandatangani dengan SESSION_SECRET setelah Firebase memverifikasi login.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Opsional, khusus demo: login dengan email+password ini (tanpa Firebase)
# memberi peran "super-admin" yang bisa membuka /store-admin DAN
# /store-managment sekaligus, tanpa perlu dua akun berbeda. Kosongkan untuk
# menonaktifkan jalur ini.
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_NAME=

# Konfigurasi klien Firebase. Peran dibaca dari custom claim `role` pada ID token.
# Nilai yang dikenali: store-admin dan store-management.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAvSg_FSYhHEbmcuIugoGdwwpFoC4pJYMs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=komoiq-nonprod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=komoiq-nonprod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=komoiq-nonprod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=874878105166
NEXT_PUBLIC_FIREBASE_APP_ID=1:874878105166:web:3c044d744049a9cfe8b51f
