# Prod profile — baked into the image at `docker build --build-arg APP_ENV=prod`.
# Only NEXT_PUBLIC_* values belong here (see DOCKER.md for why). Copy to
# .env.prod and fill in the real production Firebase project's values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=komoiq-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
